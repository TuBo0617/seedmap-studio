{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seedmap Studio",
  "version": "0.1.0",
  "identifier": "dev.seedmap.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seedmap Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}

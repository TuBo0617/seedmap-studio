{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seedmap Studio",
  "version": "0.1.0",
  "identifier": "dev.seedmap.studio",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seedmap Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Minecraft seed map",
    "longDescription": "Explore Minecraft Java Edition worlds from a seed: biome terrain, structures, spawn point and multiple dimensions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
